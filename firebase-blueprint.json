{
  "entities": {
    "ExclusionEntry": {
      "title": "ExclusionEntry",
      "description": "Entrada normalizada de lista de exclusión propiedad del usuario (teléfono peruano, dominio o Place ID).",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["phone", "domain", "placeId"]
        },
        "normalizedValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rawSample": {
          "type": "string",
          "maxLength": 200
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "type", "normalizedValue", "rawSample", "sourceLabel", "createdAt"]
    },
    "DiscardRecord": {
      "title": "DiscardRecord",
      "description": "Referencia por Place ID de establecimiento descartado por el usuario (sin almacenar contenido restringido de Maps).",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "placeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "discardedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "placeId", "reason", "discardedAt"]
    },
    "FollowupLeadRecord": {
      "title": "FollowupLeadRecord",
      "description": "Registro CRM comercial: guarda Place ID + metadatos permitidos o datos capturados independientemente por el usuario (nunca contenido exportable directo de Google Maps).",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "placeId": {
          "type": "string",
          "maxLength": 160
        },
        "sourceKind": {
          "type": "string",
          "enum": ["places_preselection", "independent_manual"]
        },
        "independentBusinessName": {
          "type": "string",
          "maxLength": 160
        },
        "district": {
          "type": "string",
          "maxLength": 120
        },
        "confirmedNoWebsite": {
          "type": "boolean"
        },
        "independentWebsiteStatus": {
          "type": "string",
          "enum": [
            "unregistered",
            "confirmed_none",
            "active_https",
            "active_http",
            "social_only",
            "unreachable_verified",
            "unverified_inconclusive",
            "invalid_url"
          ]
        },
        "independentPhone": {
          "type": "string",
          "maxLength": 40
        },
        "phoneStage": {
          "type": "string",
          "enum": [
            "none",
            "registered_invalid",
            "registered_valid_format",
            "independently_corroborated",
            "contact_reached"
          ]
        },
        "independentEmail": {
          "type": "string",
          "maxLength": 160
        },
        "independentDigitalScore": {
          "type": "number"
        },
        "independentContactScore": {
          "type": "number"
        },
        "stage": {
          "type": "string",
          "enum": [
            "PRESELECCIONADO",
            "PENDIENTE DE VERIFICACIÓN",
            "CONTACTO AUTORIZADO",
            "CONTACTADO",
            "RESPONDIÓ",
            "INTERESADO",
            "COTIZACIÓN",
            "CLIENTE",
            "DESCARTADO"
          ]
        },
        "legalBasis": {
          "type": "string",
          "maxLength": 300
        },
        "qualificationTier": {
          "type": "string",
          "enum": ["", "PRIORIDAD ALTA", "REVISIÓN PENDIENTE", "NO ELEGIBLE"]
        },
        "aiSummary": {
          "type": "string",
          "maxLength": 800
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "placeId",
        "sourceKind",
        "independentBusinessName",
        "district",
        "confirmedNoWebsite",
        "independentWebsiteStatus",
        "independentPhone",
        "phoneStage",
        "independentEmail",
        "independentDigitalScore",
        "independentContactScore",
        "stage",
        "legalBasis",
        "qualificationTier",
        "aiSummary",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/exclusions/{exclusionId}": {
      "schema": { "$ref": "#/entities/ExclusionEntry" },
      "description": "Entradas normalizadas de exclusión privadas por UID autorizado."
    },
    "/users/{userId}/discards/{placeId}": {
      "schema": { "$ref": "#/entities/DiscardRecord" },
      "description": "Place IDs descartados privados por UID autorizado."
    },
    "/users/{userId}/followups/{followupId}": {
      "schema": { "$ref": "#/entities/FollowupLeadRecord" },
      "description": "Seguimiento comercial independiente y referencias Place ID privadas por UID autorizado."
    }
  }
}
