rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedEmail() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidExclusion(data, userId) {
      return data.keys().hasAll(['ownerUid', 'type', 'normalizedValue', 'rawSample', 'sourceLabel', 'createdAt']) &&
        data.keys().hasOnly(['ownerUid', 'type', 'normalizedValue', 'rawSample', 'sourceLabel', 'createdAt']) &&
        data.ownerUid is string && data.ownerUid == userId &&
        data.type in ['phone', 'domain', 'placeId'] &&
        data.normalizedValue is string && data.normalizedValue.size() >= 1 && data.normalizedValue.size() <= 200 &&
        data.rawSample is string && data.rawSample.size() <= 200 &&
        data.sourceLabel is string && data.sourceLabel.size() >= 1 && data.sourceLabel.size() <= 120 &&
        data.createdAt == request.time;
    }

    function isValidDiscard(data, userId, placeId) {
      return data.keys().hasAll(['ownerUid', 'placeId', 'reason', 'discardedAt']) &&
        data.keys().hasOnly(['ownerUid', 'placeId', 'reason', 'discardedAt']) &&
        data.ownerUid is string && data.ownerUid == userId &&
        data.placeId is string && data.placeId == placeId && isValidId(data.placeId) &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
        data.discardedAt == request.time;
    }

    function isValidWebsiteStatus(status) {
      return status in [
        'unregistered',
        'confirmed_none',
        'active_https',
        'active_http',
        'social_only',
        'unreachable_verified',
        'unverified_inconclusive',
        'invalid_url'
      ];
    }

    function isValidPhoneStage(stage) {
      return stage in [
        'none',
        'registered_invalid',
        'registered_valid_format',
        'independently_corroborated',
        'contact_reached'
      ];
    }

    function isValidPhoneType(lineType) {
      return lineType in [
        'none',
        'mobile',
        'landline_lima',
        'landline_regional',
        'invalid'
      ];
    }

    function isValidCompletenessStatus(status) {
      return status in ['complete', 'partial', 'place_id_only'];
    }

    function isValidCommercialOutcome(outcome) {
      return outcome in [
        'none',
        'datos_incorrectos',
        'numero_inexistente',
        'sin_respuesta',
        'no_corresponde',
        'no_interesado',
        'respondio',
        'interesado',
        'cotizacion_enviada',
        'venta_confirmada',
        'no_volver_a_contactar'
      ];
    }

    function isValidFollowupStage(stage) {
      return stage in [
        'PRESELECCIONADO',
        'PENDIENTE DE VERIFICACIÓN',
        'CONTACTO AUTORIZADO',
        'CONTACTADO',
        'RESPONDIÓ',
        'INTERESADO',
        'COTIZACIÓN',
        'CLIENTE',
        'DESCARTADO'
      ];
    }

    function requiresLegalBasis(stage) {
      return stage in [
        'CONTACTO AUTORIZADO',
        'CONTACTADO',
        'RESPONDIÓ',
        'INTERESADO',
        'COTIZACIÓN',
        'CLIENTE'
      ];
    }

    function isValidQualificationTier(tier) {
      return tier in ['', 'PRIORIDAD ALTA', 'REVISIÓN PENDIENTE', 'NO ELEGIBLE'];
    }

    function isValidOptionalIndependentFields(data) {
      return (!('independentAddress' in data) || (data.independentAddress is string && data.independentAddress.size() <= 200)) &&
        (!('independentWebsite' in data) || (data.independentWebsite is string && data.independentWebsite.size() <= 300)) &&
        (!('independentCategory' in data) || (data.independentCategory is string && data.independentCategory.size() <= 120)) &&
        (!('independentPhoneType' in data) || (data.independentPhoneType is string && isValidPhoneType(data.independentPhoneType))) &&
        (!('independentTrustScore' in data) || (data.independentTrustScore is number && data.independentTrustScore >= 0 && data.independentTrustScore <= 100)) &&
        (!('completenessStatus' in data) || (data.completenessStatus is string && isValidCompletenessStatus(data.completenessStatus))) &&
        (!('verificationSummary' in data) || (data.verificationSummary is string && data.verificationSummary.size() <= 400)) &&
        (!('lastVerifiedAt' in data) || (data.lastVerifiedAt is string && data.lastVerifiedAt.size() <= 40)) &&
        (!('verificationSources' in data) || (
          data.verificationSources is list &&
          data.verificationSources.size() <= 8 &&
          (data.verificationSources.size() == 0 || (data.verificationSources[0] is string && data.verificationSources[0].size() <= 240))
        )) &&
        (!('commercialOutcome' in data) || (data.commercialOutcome is string && isValidCommercialOutcome(data.commercialOutcome))) &&
        (!('outcomeSource' in data) || (data.outcomeSource is string && data.outcomeSource.size() <= 120)) &&
        (!('outcomeContext' in data) || (data.outcomeContext is string && data.outcomeContext.size() <= 300)) &&
        (!('outcomeRecordedAt' in data) || (data.outcomeRecordedAt is string && data.outcomeRecordedAt.size() <= 40)) &&
        (!('outcomeHistory' in data) || (
          data.outcomeHistory is list &&
          data.outcomeHistory.size() <= 10 &&
          (data.outcomeHistory.size() == 0 || (data.outcomeHistory[0] is string && data.outcomeHistory[0].size() <= 240))
        ));
    }

    function isValidFollowup(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'placeId',
          'sourceKind',
          'independentBusinessName',
          'district',
          'confirmedNoWebsite',
          'independentWebsiteStatus',
          'independentPhone',
          'phoneStage',
          'independentEmail',
          'independentDigitalScore',
          'independentContactScore',
          'stage',
          'legalBasis',
          'qualificationTier',
          'aiSummary',
          'notes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'placeId',
          'sourceKind',
          'independentBusinessName',
          'district',
          'confirmedNoWebsite',
          'independentWebsiteStatus',
          'independentPhone',
          'phoneStage',
          'independentEmail',
          'independentDigitalScore',
          'independentContactScore',
          'independentTrustScore',
          'completenessStatus',
          'stage',
          'legalBasis',
          'qualificationTier',
          'aiSummary',
          'notes',
          'independentAddress',
          'independentWebsite',
          'independentCategory',
          'independentPhoneType',
          'verificationSummary',
          'lastVerifiedAt',
          'verificationSources',
          'commercialOutcome',
          'outcomeSource',
          'outcomeContext',
          'outcomeRecordedAt',
          'outcomeHistory',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string && data.ownerUid == userId &&
        data.placeId is string && data.placeId.size() >= 1 && data.placeId.size() <= 160 &&
        data.sourceKind in ['places_preselection', 'independent_manual'] &&
        data.independentBusinessName is string && data.independentBusinessName.size() <= 160 &&
        (data.sourceKind == 'places_preselection' || data.independentBusinessName.size() >= 1) &&
        data.district is string && data.district.size() <= 120 &&
        data.confirmedNoWebsite is bool &&
        data.independentWebsiteStatus is string && isValidWebsiteStatus(data.independentWebsiteStatus) &&
        data.independentPhone is string && data.independentPhone.size() <= 40 &&
        data.phoneStage is string && isValidPhoneStage(data.phoneStage) &&
        data.independentEmail is string && data.independentEmail.size() <= 160 &&
        data.independentDigitalScore is number && data.independentDigitalScore >= 0 && data.independentDigitalScore <= 100 &&
        data.independentContactScore is number && data.independentContactScore >= 0 && data.independentContactScore <= 100 &&
        data.stage is string && isValidFollowupStage(data.stage) &&
        data.legalBasis is string && data.legalBasis.size() <= 300 &&
        (!requiresLegalBasis(data.stage) || data.legalBasis.size() >= 8) &&
        data.qualificationTier is string && isValidQualificationTier(data.qualificationTier) &&
        data.aiSummary is string && data.aiSummary.size() <= 800 &&
        data.notes is string && data.notes.size() <= 1000 &&
        isValidOptionalIndependentFields(data) &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isAllowedFollowupUpdate(userId) {
      return isValidFollowup(incoming(), userId) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().placeId == existing().placeId &&
        incoming().sourceKind == existing().sourceKind && (
          // Action 1: Active pipeline stage, legalBasis, independent verification, outcomes, or contact update
          (existing().stage != 'CLIENTE' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'independentBusinessName',
              'district',
              'confirmedNoWebsite',
              'independentWebsiteStatus',
              'independentPhone',
              'phoneStage',
              'independentEmail',
              'independentDigitalScore',
              'independentContactScore',
              'independentTrustScore',
              'completenessStatus',
              'stage',
              'legalBasis',
              'qualificationTier',
              'aiSummary',
              'notes',
              'independentAddress',
              'independentWebsite',
              'independentCategory',
              'independentPhoneType',
              'verificationSummary',
              'lastVerifiedAt',
              'verificationSources',
              'commercialOutcome',
              'outcomeSource',
              'outcomeContext',
              'outcomeRecordedAt',
              'outcomeHistory',
              'updatedAt'
            ])) ||
          // Action 2: Client stage locked; only notes, commercial outcome history & timestamp editable
          (existing().stage == 'CLIENTE' &&
            incoming().stage == 'CLIENTE' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'notes',
              'commercialOutcome',
              'outcomeSource',
              'outcomeContext',
              'outcomeRecordedAt',
              'outcomeHistory',
              'updatedAt'
            ]))
        );
    }

    match /users/{userId}/exclusions/{exclusionId} {
      allow get: if isOwner(userId) && isValidId(exclusionId);
      allow list: if isOwner(userId) && existing().ownerUid == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(exclusionId) && isValidExclusion(incoming(), userId);
      allow update: if false;
      allow delete: if isOwner(userId) && isValidId(exclusionId) && existing().ownerUid == request.auth.uid;
    }

    match /users/{userId}/discards/{placeId} {
      allow get: if isOwner(userId) && isValidId(placeId);
      allow list: if isOwner(userId) && existing().ownerUid == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(placeId) && isValidDiscard(incoming(), userId, placeId);
      allow update: if false;
      allow delete: if isOwner(userId) && isValidId(placeId) && existing().ownerUid == request.auth.uid;
    }

    match /users/{userId}/followups/{followupId} {
      allow get: if isOwner(userId) && isValidId(followupId);
      allow list: if isOwner(userId) && existing().ownerUid == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(followupId) &&
        isValidFollowup(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidId(followupId) && isAllowedFollowupUpdate(userId);
      allow delete: if isOwner(userId) && isValidId(followupId) && existing().ownerUid == request.auth.uid;
    }

    match /users/{userId}/sandbox_followups/{followupId} {
      allow get: if isOwner(userId) && isValidId(followupId);
      allow list: if isOwner(userId) && existing().ownerUid == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(followupId) &&
        isValidFollowup(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidId(followupId) && isAllowedFollowupUpdate(userId);
      allow delete: if isOwner(userId) && isValidId(followupId) && existing().ownerUid == request.auth.uid;
    }
  }
}
